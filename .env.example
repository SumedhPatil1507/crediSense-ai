# Copy to .env for local development. Production secrets belong in a secret manager.

# API security
API_SECRET_KEY=replace-with-a-random-secret-before-use
API_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Kafka application ingestion
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_GROUP_ID=credisense-credit-applications
DATABASE_URL=postgresql://credisense:credisense-local-only@localhost:5432/credisense
REDIS_URL=redis://localhost:6380/0
FEAST_REDIS_CONNECTION_STRING=localhost:6380
PAN_HASH_SECRET=replace-with-a-separate-random-secret-before-use
STREAM_METRICS_PORT=9108

# Optional OpenTelemetry OTLP trace export (leave endpoint blank to keep spans local).
OTEL_SERVICE_NAME=credisense-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Optional market-data WebSocket bridge. Populate with the provider's licensed
# endpoint and JSON auth/subscription messages. Raw events go to a staging topic;
# normalize them into MARKET_DATA_TOPIC before Feast feature ingestion.
MARKET_WS_URL=
MARKET_WS_AUTH_MESSAGE=
MARKET_WS_SUBSCRIBE_MESSAGE=
MARKET_RAW_TOPIC=market.provider.raw.v1
MARKET_DATA_TOPIC=market.orderbook.features.v1
MARKET_KAFKA_GROUP_ID=credisense-market-features

# Optional heterogeneous GNN score lookup / training export
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-secret
NEO4J_DATABASE=neo4j

# Optional external integrations
ALERT_WEBHOOK_URL=
OPENAI_API_KEY=
GROQ_API_KEY=
