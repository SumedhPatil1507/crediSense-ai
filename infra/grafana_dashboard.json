{
  "title": "CrediSense AI — MLOps Dashboard",
  "uid": "credisense-mlops",
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Predictions per Minute",
      "type": "stat",
      "targets": [{"expr": "rate(credisense_predictions_total[1m])", "legendFormat": "req/min"}]
    },
    {
      "title": "Decision Distribution",
      "type": "piechart",
      "targets": [{"expr": "credisense_predictions_total", "legendFormat": "{{decision}}"}]
    },
    {
      "title": "Risk Score Distribution",
      "type": "histogram",
      "targets": [{"expr": "credisense_risk_score_bucket", "legendFormat": "Risk Score"}]
    },
    {
      "title": "API Latency P95",
      "type": "stat",
      "targets": [{"expr": "histogram_quantile(0.95, rate(credisense_prediction_latency_ms_bucket[5m]))", "legendFormat": "p95 latency ms"}]
    },
    {
      "title": "Model PSI (Drift)",
      "type": "gauge",
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color":"green","value":0},{"color":"yellow","value":0.1},{"color":"red","value":0.2}]}}},
      "targets": [{"expr": "credisense_model_psi", "legendFormat": "PSI"}]
    },
    {
      "title": "HITL Queue Depth",
      "type": "gauge",
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color":"green","value":0},{"color":"yellow","value":10},{"color":"red","value":20}]}}},
      "targets": [{"expr": "credisense_hitl_queue_pending", "legendFormat": "Pending"}]
    }
  ]
}
